@using ImperialVip.WebUI.Models
@model BizeUlasinDTO


<!-- ##### Bize Ulaşın ##### -->
<section id="BizeUlasin" class="contact section">

    <div class="container section-title" data-aos="fade-up">
        <span>BİZE ULAŞIN<br></span>
        <h2>BİZE ULAŞIN</h2>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4 contact-content">
            <div class="col-lg-8">
                <form id="bizeUlasin" method="post" data-aos="fade-up" data-aos-delay="200">
                    <div class="row gy-4">

                        <div class="col-md-12">
                            @Html.EditorFor(model => model.AdSoyad, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "Adınız Soyadınız", required = "required" } })
                        </div>

                        <div class="col-md-6">
                            @Html.EditorFor(model => model.Telefon, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "05553336655", required = "required" } })
                        </div>

                        <div class="col-md-6 ">
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", type = "email", placeholder = "abc@gmail.com", required = "required" } })
                        </div>

                        <div class="col-md-12">
                            @Html.TextAreaFor(model => model.Mesaj, new { @class = "form-control", type = "text", rows = "6", placeholder = "Mesajınızı giriniz ...", required = "required" })
                        </div>

                        <div class="col-md-12 text-center">
                            <button class="btn btn-rezervasyon form-control" type="submit">GÖNDER</button>
                        </div>

                    </div>
                </form>
            </div><!-- End Contact Form -->
        </div>
    </div>
</section>
<!-- ##### Bize Ulaşın ##### -->
