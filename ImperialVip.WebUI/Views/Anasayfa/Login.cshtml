@model ImperialVip.DataAccess.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="~/Content/adminAssets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="~/Content/adminAssets/img/favicon.png">
    <title>
        Login - Imperial VIP Transfer
    </title>
    <!--     Fonts and icons     -->
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <!-- Nucleo Icons -->
    <link href="~/Content/adminAssets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="~/Content/adminAssets/css/nucleo-svg.css" rel="stylesheet" />
    <!-- Font Awesome Icons -->
    <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>
    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <!-- CSS Files -->
    <link id="pagestyle" href="~/Content/adminAssets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
</head>

<body class="bg-gray-200">
    <main class="main-content  mt-0">
        <div class="page-header align-items-start min-vh-100" style="background-image: url('https://images.unsplash.com/photo-1497294815431-9365093b7331?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1950&q=80');">
            <span class="mask bg-gradient-dark opacity-6"></span>
            <div class="container my-auto">
                <div class="row">
                    <div class="col-lg-4 col-md-8 col-12 mx-auto">
                        <div class="card z-index-0 fadeIn3 fadeInBottom">
                            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                                <div class="bg-gradient-primary shadow-primary border-radius-lg py-3 pe-1">
                                    <h4 class="text-white font-weight-bolder text-center mt-2 mb-0">Imperial VIP Transfer</h4>
                                    <h4 class="text-white font-weight-bolder text-center mt-2 mb-0">Giriş</h4>
                                </div>
                            </div>
                            <div class="card-body">
                                @using (Html.BeginForm("Login", "Anasayfa", FormMethod.Post, new { enctype = "multipart/form-data", role = "form", @class = "text-start" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true)

                                    @*<form action="@Url.Action()" method="post">*@
                                    <div class="my-3">
                                        <label for="Username" class="form-label flex-gap-10"><i class="bi bi-calendar3"></i>Kullanıcı Adı</label>
                                        @Html.Editor("Username", new { htmlAttributes = new { @class = "form-control", type = "text", required = "required" } })
                                    </div>
                                    <div class="mb-3">
                                        <label for="Password" class="form-label flex-gap-10"><i class="bi bi-calendar3"></i>Şifre</label>
                                        @Html.Editor("Password", new { htmlAttributes = new { @class = "form-control", type = "password", required = "required" } })
                                    </div>
                                    <div class="form-group" style="text-align: end;">
                                        <a href="javascript;" class="form-label">Şifremi unuttum !</a>
                                    </div>
                                    <div class="text-center">
                                        <button type="submit" class="btn bg-gradient-primary w-100 p-15 my-4 mb-2">GİRİŞ</button>
                                    </div>
                                    @*</form>*@
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer position-absolute bottom-2 py-2 w-100">
                <div class="container">
                    <div class="row align-items-center justify-content-lg-between">
                        <div class="col-12 my-auto">
                            <div class="copyright text-center text-sm text-white text-center">
                                © Copyright
                                <script>
                                    document.write(new Date().getFullYear())
                                </script>
                                Tüm Hakları Saklıdır.
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </main>
    <!--   Core JS Files   -->
    <script src="~/Content/adminAssets/js/core/popper.min.js"></script>
    <script src="~/Content/adminAssets/js/core/bootstrap.min.js"></script>
    <script src="~/Content/adminAssets/js/plugins/perfect-scrollbar.min.js"></script>
    <script src="~/Content/adminAssets/js/plugins/smooth-scrollbar.min.js"></script>
    <script>
        var win = navigator.platform.indexOf('Win') > -1;
        if (win && document.querySelector('#sidenav-scrollbar')) {
            var options = {
                damping: '0.5'
            }
            Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
        }
    </script>
    <!-- Github buttons -->
    <script async defer src="https://buttons.github.io/buttons.js"></script>
    <script src="~/Content/adminAssets/js/material-dashboard.min.js?v=3.1.0"></script>
</body>

</html>
