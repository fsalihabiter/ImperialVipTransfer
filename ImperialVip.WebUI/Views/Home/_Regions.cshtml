
@model List<ImperialVip.DataAccess.ViewModels.BolgeDetayViewModel>

<section id="Regions" class="services section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <span>REGIONS<br></span>
        <h2>REGIONS</h2>
    </div>
    <!-- End Section Title -->

    <div class="container">
        <div class="row gy-4">
            <!-- Start Card Item -->
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="300">
                    <div class="card" style="background-image: url(../../Content/imgs/@item.ResimUrl);">
                        <div class="card-text">
                            <h3 class="text-center"><span class="text-white">@item.BolgeAdi</span></h3>
                            <p class="text-white text-center">@item.BolgeAdi <i class="bi bi-arrow-right"></i> Antalya Airport</p>
                            <p class="text-white text-center price-text">Prices starting with &nbsp;<span class="price">@item.Fiyat €</span></p>
                            <a class="btn btn-rezervasyon form-control" href="@Url.Action("Reservation", "Home")">Create Reservation</a>
                        </div>
                    </div>
                </div>
            }
            <!-- End Card Item -->
            <div class="col-12 p-5 text-center" data-aos="fade-up" data-aos-delay="300">
                <a class="btn btn-rezervasyon form-control" href="@Url.Action("AllRegions", "Home")"><i class="bi bi-chevron-double-right"></i> View All Regions <i class="bi bi-chevron-double-left"></i></a>
            </div>
        </div>
    </div>
</section>