
@model ImperialVip.DataAccess.Entities.Bolge

<div class="modal fade" id="bolgeEkleModal" tabindex="-1" aria-labelledby="bolgeEkleModal" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark">
                <h1 class="modal-title text-white fs-5 p-3" id="bolgeEkleModal">Bölge Ekle</h1>
                <button type="button" class="btn-close text-white-50" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("BolgeEkle", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", role = "form" }))
            {
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="recipient-name" class="col-form-label">Bölge Adı :</label>
                        @Html.EditorFor(model => model.BolgeAdi, new { htmlAttributes = new { @class = "form-control", type = "text", required = "required" } })
                    </div>
                    <div class="mb-3">
                        <label for="recipient-name" class="col-form-label">Bölge Resmi :</label>
                        <input type="file" name="imgFile" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="recipient-name" class="col-form-label">Bölge Detay :</label>
                        @Html.TextAreaFor(model => model.BolgeDetay, 10, 30, new { @class = "form-control", type = "text", required = "required" })
                    </div>
                    <div class="mb-3 check-input">
                        @Html.EditorFor(model => model.AlisNoktasiMi, new { htmlAttributes = new { @class = "form-check-input pl-3", type = "checkbox" } })
                        <label for="recipient-name" class="col-form-label">Aliş Noktası Mı ?</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-outline-success">Ekle</button>
                </div>
            }
        </div>
    </div>
</div>
