@model List<ImperialVip.DataAccess.ViewModels.RezervasyonModel>

@{
    ViewBag.Title = "Rezervasyon İşlemleri";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/2.1.5/css/dataTables.bootstrap5.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/3.1.2/css/buttons.bootstrap5.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/staterestore/1.4.1/css/stateRestore.bootstrap5.css" rel="stylesheet" />

<div class="card my-4">
    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3">
            <h6 class="text-white text-capitalize ps-3">Rezervasyon İşlemleri</h6>
        </div>
    </div>
    <div class="card-body p-5">
        <div class="p-0">
            <table id="example" class="table table-striped table-hover table-responsive align-items-center mb-0">
                <thead class="table-group-divider">
                    <tr>
                        <th class="text-center font-weight-bolder opacity-7">Kayıt Tarihi</th>
                        <th class="text-center font-weight-bolder opacity-7">Alış Noktası</th>
                        <th class="text-center font-weight-bolder opacity-7 ps-2">Varış Noktası</th>
                        <th class="text-center font-weight-bolder opacity-7">Kişi Sayısı</th>
                        <th class="text-center font-weight-bolder opacity-7">Araç Türü</th>
                        <th class="text-center font-weight-bolder opacity-7">Geliş Zamanı</th>
                        <th class="text-center font-weight-bolder opacity-7">Fiyat</th>
                        <th class="text-center font-weight-bolder opacity-7">Rezervasyon Durumu</th>
                        <th class="text-center text-secondary opacity-7"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>
                            <p class="align-middle text-center text-sm mb-0">@item.KayitTarihi.ToShortDateString()</p>
                        </td>
                        <td>
                            <p class="align-middle text-center text-sm mb-0">@item.AlisNoktasiAdi</p>
                        </td>
                        <td>
                            <p class="align-middle text-center text-sm mb-0">@item.VarisNoktasiAdi</p>
                        </td>
                        <td class="align-middle text-center text-sm">
                            <p class="align-middle text-center text-sm mb-0">@item.KisiSayisi</p>
                        </td>
                        <td class="align-middle text-center text-sm">
                            <p class="align-middle text-center text-sm mb-0">@item.AracAdi</p>
                        </td>
                        <td class="align-middle text-center text-sm">
                            <p class="align-middle text-center text-sm mb-0">@item.GelisTarihi.ToShortDateString() - @item.GelisTarihi.ToShortTimeString()</p>
                        </td>
                        <td>
                            <p class="align-middle text-center text-sm mb-0">@item.Fiyat €</p>
                        </td>
                        <td class="align-middle text-center text-sm">
                            @if (item.RezervasyonOnay)
                            {
                                <p class="align-middle text-center text-sm mb-0">Onaylandı</p>
                            }
                            else
                            {
                                <p class="align-middle text-center text-sm mb-0">Onay Bekliyor</p>
                            }
                        </td>
                        <td class="align-middle text-center text-sm">
                            <a href="@Url.Action("RezervasyonDetay", "Admin", new { id = item.Id })" class="btn btn-outline-warning m-0" data-toggle="tooltip" data-original-title="Edit">
                                Detay
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th class="text-center font-weight-bolder opacity-7">Kayıt Tarihi</th>
                        <th class="text-center font-weight-bolder opacity-7">Alış Noktası</th>
                        <th class="text-center font-weight-bolder opacity-7 ps-2">Varış Noktası</th>
                        <th class="text-center font-weight-bolder opacity-7">Kişi Sayısı</th>
                        <th class="text-center font-weight-bolder opacity-7">Araç Türü</th>
                        <th class="text-center font-weight-bolder opacity-7">Geliş Zamanı</th>
                        <th class="text-center font-weight-bolder opacity-7">Fiyat</th>
                        <th class="text-center font-weight-bolder opacity-7">Rezervasyon Durumu</th>
                        <th class="text-center text-secondary opacity-7"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.1.5/js/dataTables.js"></script>
<script src="https://cdn.datatables.net/2.1.5/js/dataTables.bootstrap5.js"></script>
<script src="https://cdn.datatables.net/staterestore/1.4.1/js/dataTables.stateRestore.js"></script>
<script src="https://cdn.datatables.net/staterestore/1.4.1/js/stateRestore.bootstrap5.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.2/js/dataTables.buttons.js"></script>
<script src="https://cdn.datatables.net/buttons/3.1.2/js/buttons.bootstrap5.js"></script>
<script src="~/Content/adminAssets/js/datatable.js"></script>