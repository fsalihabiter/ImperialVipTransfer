

@model List<ImperialVip.DataAccess.Entities.Yorum>

<section id="Comments" class="testimonials section dark-background">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="swiper init-swiper">
            <script type="application/json" class="swiper-config">
                {
                  "loop": true,
                  "speed": 600,
                  "autoplay": {
                    "delay": 5000
                  },
                  "slidesPerView": "auto",
                  "pagination": {
                    "el": ".swiper-pagination",
                    "type": "bullets",
                    "clickable": true
                  }
                }
            </script>
            <div class="swiper-wrapper">
                @if (Model.Count > 0)
                {
                    foreach (var yorum in Model)
                    {
                        <div class="swiper-slide">
                            <div class="testimonial-item">
                                @if (yorum.AdSoyad != null && !yorum.AdSoyad.IsEmpty())
                                {
                                    <h3>@yorum.AdSoyad</h3>
                                }
                                <div class="stars">
                                    @for (int i = 0; i < yorum.MemnuniyetOyu; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    @for (int i = 0; i < 5 - yorum.MemnuniyetOyu; i++)
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                </div>
                                <p>
                                    <i class="bi bi-quote quote-icon-left"></i>
                                    <span>@yorum.YorumDetay</span>
                                    <i class="bi bi-quote quote-icon-right"></i>
                                </p>
                                <p>
                                    <span>@yorum.YorumTarihi.ToShortDateString()</span>
                                </p>
                            </div>
                        </div>
                    }
                }

            </div>
            <div class="swiper-pagination"></div>
        </div>

    </div>

    <div class="container">
        <div class="row gy-4 contact-content">
            <div class="col-lg-8">
                <h4 class="pb-5 pt-3 text-2xl text-warning text-center">Teilen Sie uns Ihre Zufriedenheit mit</h4>
                <form id="commentsDe" method="post" class="php-email-form" data-aos="fade-up" data-aos-delay="200">
                    <div class="row gy-4">

                        <div class="col-md-12">
                            <label for="AdSoyad" class="form-label">Vorname Nachname : </label>
                            <input type="text" class="form-control" name="CommentAdSoyad" placeholder="Vorname Nachname" required />
                        </div>

                        <div class="col-md-12">
                            <label for="MemnuniyetOyu" class="form-label">Zufriedenheitsbewertung : </label>
                            <input type="number" class="form-control" name="CommentMemnuniyetOyu" max="5" min="1" value="5" required />
                        </div>

                        <div class="col-md-12">
                            <label for="Yorum" class="form-label">Your comment : </label>
                            <textarea name="CommentYorum" class="form-control" placeholder="Schreiben Sie Ihren Kommentar..." rows="5" required></textarea>
                        </div>

                        <div class="col-md-12 text-center">
                            <button class="btn btn-rezervasyon form-control" type="submit">KOMMENTAR SCHREIBEN</button>
                        </div>

                    </div>
                </form>
            </div><!-- End Contact Form -->
        </div>
    </div>
</section>